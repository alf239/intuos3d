<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.intuos3d</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Library/Application Support/intuos3d/intuos3d</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/intuos3d.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/intuos3d.log</string>
</dict>
</plist>
